# Copie para .env e preencha. Tudo é opcional para rodar local em modo de teste.

PORT=3000

# Endereço público do app. A Meta e o TikTok baixam as mídias por aqui,
# então em produção precisa ser HTTPS e acessível pela internet.
PUBLIC_URL=http://localhost:3000

# Chave usada para cifrar os tokens das redes sociais no banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Em branco, o app gera uma e guarda em data/secret.key.
APP_SECRET=

# Pasta do banco SQLite e dos uploads
DATA_DIR=./data

# Plano dado a quem se cadastra (teste, solo, pro, agencia)
DEFAULT_PLAN=teste
# false fecha o cadastro público (contas passam a ser criadas por scripts/plan.js)
ALLOW_SIGNUP=true

# Instagram — app da Meta com o produto "Instagram API with Instagram Login".
# Redirect URI a cadastrar: {PUBLIC_URL}/oauth/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Facebook (Páginas) — app da Meta com Facebook Login for Business.
# Redirect URI a cadastrar: {PUBLIC_URL}/oauth/facebook/callback
META_APP_ID=
META_APP_SECRET=
GRAPH_API_VERSION=v24.0

# TikTok — app no TikTok for Developers com Login Kit + Content Posting API.
# Redirect URI a cadastrar: {PUBLIC_URL}/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Agendador
SCHEDULER_INTERVAL_MS=10000
SCHEDULER_CONCURRENCY=4
MAX_UPLOAD_MB=500

# Contas simuladas: fração de publicações que falham de propósito (0 a 1)
SIM_FAIL_RATE=0
